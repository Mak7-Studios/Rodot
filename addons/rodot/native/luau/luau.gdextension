[configuration]

entry_symbol = "gdluau_entrypoint"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

macos.debug = "bin/libgdluau.darwin.arm64.debug.dylib"
macos.release = "bin/libgdluau.darwin.arm64.dylib"
windows.debug.x86_64 = "bin/rodot_luau.windows.x86_64.dll"
windows.release.x86_64 = "bin/rodot_luau.windows.x86_64.dll"
linux.debug.x86_64 = "bin/libgdluau.linux.x86_64.debug.so"
linux.release.x86_64 = "bin/libgdluau.linux.x86_64.so"


